# --- Personal financial data -------------------------------------------
# Your actual positions: quantities, average costs, P&L, tax lots.
# Deliberately excluded even from a private repo. A private repo can be made
# public by a misclick, collaborators added later see the whole history, and
# git history is permanent -- removing a committed file needs a history
# rewrite. The framework works with any holdings file, so the data does not
# need to live in the repo at all.
config/holdings.csv
config/holdings.csv.bak
# Broker downloads dropped in for import_kite_holdings.py.
config/*.xlsx
config/*.xls
config/holdings*.csv
# The watch list: what you are watching is yours too (config/*.xlsx above
# already covers watching.xlsx).
config/watching.csv
!config/holdings.example.csv
# Your MF book as percentages (run_mf.py).
config/mf_holdings.csv
data/holdings.json
.env
# Results scorecards (run_results.py). The figures are public, but the list of
# symbols covered includes your holdings.
data/results/

# --- Large generated data ----------------------------------------------
# market.db is ~450MB; GitHub rejects files over 100MB and this is entirely
# reproducible with run_market_ingest.py.
data/*.db
data/*.db-wal
data/*.db-shm
data/cache/

# --- Fetched / derived config ------------------------------------------
# All regenerable, and stale within days. NOTE: git does not support inline
# comments in .gitignore -- a trailing "# note" becomes part of the pattern
# and the file silently stays tracked. Comments go on their own lines.
#
# config/fundamentals.csv <- fetch_fundamentals.py
# config/equities.csv, config/etfs.csv <- instruments.snapshot()
# config/watchlist.csv <- seeded from the NIFTY index lists
# config/fno_calibration.json, config/fno_reach.json <- run_fno_backtest.py,
#   rebuilt weekly by run_weekly.py from data/fo_history.db. The live F&O
#   view reads them; without them it falls back to scoring.yaml's hand-entered
#   hit rates and shows no reach probabilities.
config/fundamentals.csv
config/equities.csv
config/etfs.csv
config/watchlist.csv
config/fno_calibration.json
config/fno_reach.json
# config/range_calibration.json <- run_range_backtest.py (Saturday job); Today
#   shows the ranges without a hit rate until it exists.
config/range_calibration.json
# config/factor_calibration.json <- run_factor_backtest.py (52-week high, low vol).
config/factor_calibration.json
# config/swing_calibration.json <- run_swing.py --backtest; the Swing tab
#   shows "no backtest yet" without it.
config/swing_calibration.json
# config/results_calibration.json <- run_results_backtest.py; the Results tab
#   shows "no backtest yet" without it.
config/results_calibration.json
# config/picker_calibration.json <- run_picker.py --backtest; the GARP / QARP
#   tab warns "no backtest yet" without it.
config/picker_calibration.json
# config/*_calibration_pit.json <- the survivorship-free re-runs of the picker
#   and results backtests (run_picker.py / run_results_backtest.py on the
#   point-in-time universe); regenerable like the above.
config/picker_calibration_pit.json
config/results_calibration_pit.json

# --- Environment and noise ---------------------------------------------
# Excel's lock file while a workbook in history/ is open.
~$*
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
logs_*.txt
nohup.out
reports/
data/last_weekly_run.txt
# data/mf/mf.db <- run_mf.py --refresh: month-end NAVs of every Direct
#   Growth scheme since 2013 from AMFI, ~30MB, rebuilt from scratch in ~20 min.
data/mf/mf.db
# config/mf_calibration.json <- run_mf.py --backtest; the MF view shows
#   "no backtest yet" without it.
config/mf_calibration.json

# --- Local tool files --------------------------------------------------
# Claude Code session files: preview server config, PR description drafts,
# worktree bookkeeping. Machine-local, never part of the project.
.claude/
